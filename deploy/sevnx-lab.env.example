# Store the real file at /etc/sevnx-lab.env, owner root, mode 600.
API_BASE_URL=https://www.sevnx.lol
API_KEY=replace-with-your-upstream-api-key
# Use a separate long random token, not the upstream API key.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=/var/lib/sevnx-lab
